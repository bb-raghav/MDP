# Database Configuration
DATABASE_URL=postgresql://neondb_owner:your_password@your_host/neondb?sslmode=require&channel_binding=require

# WAQI API Key (get from https://waqi.info/api/access-token.html)
WAQI_API_KEY=your_waqi_api_key_here

# Frontend Environment (optional, defaults to http://127.0.0.1:8000)
# VITE_API_BASE_URL=http://127.0.0.1:8000
# VITE_WAQI_API_KEY=your_waqi_api_key_here
